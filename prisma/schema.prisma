// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  STAFF
}

model User {
  id                  String   @id @default(cuid())
  username            String   @unique
  passwordHash        String
  role                Role
  mustChangePassword  Boolean  @default(true)
  createdAt           DateTime @default(now())

  student Student?
  teacher Teacher?
  staff   Staff?

  markedAttendance Attendance[]

  createdExams     Exam[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  label     String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendance         Attendance[]
  exams              Exam[]
  feeDues       FeeDue[]
  payments      Payment[]
  feeStructures FeeStructure[]
}

model SchoolClass {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @unique

  sections Section[]
  feeStructures FeeStructure[]
}

model Section {
  id      String @id @default(cuid())
  name    String

  schoolClass   SchoolClass @relation(fields: [schoolClassId], references: [id])
  schoolClassId String

  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendance         Attendance[]
  exams              Exam[]

  @@unique([schoolClassId, name])
}

model Subject {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  teacherAssignments TeacherAssignment[]
  exams              Exam[]
  subjectMarks       SubjectMark[]
}

model Student {
  id              String   @id @default(cuid())
  studentCode     String   @unique
  admissionNumber String   @unique

  firstName   String
  lastName    String
  dateOfBirth DateTime
  photoUrl    String?
  gender      String?

  fatherName     String?
  fatherPhone    String?
  motherName     String?
  motherPhone    String?
  guardianName   String?
  guardianPhone  String?

  bloodGroup String?
  category   String?
  religion   String?
  address    String?
  district   String?

  hostelFacility Boolean @default(false)
  busFacility    Boolean @default(false)
  busNo          String?
  busPoint       String?

  height Float?
  weight Float?

  regNo                String?
  fathersQualification String?
  fathersOccupation    String?
  previousSchool       String?
  remarks              String?
  apaarId              String?
  penNo                String?
  aadhaarEncrypted     String?

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  enrollments Enrollment[]
  attendance  Attendance[]
  subjectMarks SubjectMark[]
  feeDues  FeeDue[]
  payments Payment[]

  createdAt DateTime @default(now())
}

model Enrollment {
  id String @id @default(cuid())

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  section   Section @relation(fields: [sectionId], references: [id])
  sectionId String

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId String

  rollNumber Int?
  isNewAdmission Boolean @default(false)

  @@unique([studentId, academicYearId])
}

model Teacher {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  phone     String?

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  assignments TeacherAssignment[]

  createdAt DateTime @default(now())
}

model TeacherAssignment {
  id String @id @default(cuid())

  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId String

  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId String

  section   Section @relation(fields: [sectionId], references: [id])
  sectionId String

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId String

  isClassTeacher Boolean @default(false)

  @@unique([teacherId, subjectId, sectionId, academicYearId])
}

model Staff {
  id            String    @id @default(cuid())
  staffCode     String    @unique
  firstName     String
  lastName      String
  designation   String
  phone         String?
  email         String?
  dateOfJoining DateTime?
  isActive      Boolean   @default(true)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// Powers safe, concurrency-proof Student ID generation
// (e.g. RBS-2026-0001).
// A single row per year is atomically incremented, so two admins
// creating students at the same moment can never receive the same number.
model IdCounter {
  id    String @id @default(cuid())
  key   String @unique
  value Int    @default(0)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}

model Attendance {
  id        String   @id @default(cuid())
  date      DateTime @db.Date

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  section   Section @relation(fields: [sectionId], references: [id])
  sectionId String

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId String

  markedBy   User   @relation(fields: [markedById], references: [id])
  markedById String

  status   AttendanceStatus @default(PRESENT)
  remarks  String?

  createdAt DateTime @default(now())

  @@unique([studentId, date, academicYearId])
  @@index([sectionId, date])
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model Exam {
  id   String   @id @default(cuid())
  name String
  type ExamType

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId String

  section   Section @relation(fields: [sectionId], references: [id])
  sectionId String

  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId String?

  totalMarks Int?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())

  marks SubjectMark[]
}

enum ExamType {
  UNIT_TEST
  HALF_YEARLY
  ANNUAL
}

model SubjectMark {
  id String @id @default(cuid())

  exam   Exam   @relation(fields: [examId], references: [id])
  examId String

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId String

  marksObtained Float?
  theoryMarks   Float?
  iaMarks       Float?
  isAbsent      Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([examId, studentId, subjectId])
}

enum FeeType {
  TUITION
  HOSTEL
  TRANSPORT
  ADMISSION
  ANNUAL
  PREVIOUS_DUES
  OTHER
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

model FeeDue {
  id             String       @id @default(cuid())

  student        Student      @relation(fields: [studentId], references: [id])
  studentId      String

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId String

  feeType        FeeType
  month          Int
  year           Int
  description    String       @default("")

  amountDue      Float
  amountPaid     Float        @default(0)
  status         FeeStatus    @default(PENDING)
  dueDate        DateTime?

  allocations    PaymentAllocation[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, academicYearId, feeType, month, year])
  @@index([studentId, status])
}

model Payment {
  id             String        @id @default(cuid())
  receiptNo      String?       @unique

  student        Student       @relation(fields: [studentId], references: [id])
  studentId      String

  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  academicYearId String

  amount         Float
  paymentDate    DateTime      @default(now())
  paymentMethod  PaymentMethod @default(CASH)
  referenceId    String?
  remarks        String?

  allocations    PaymentAllocation[]

  createdAt      DateTime      @default(now())
}

model FeeStructure {
  id String @id @default(cuid())

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId String

  schoolClass   SchoolClass @relation(fields: [schoolClassId], references: [id])
  schoolClassId String

  isBoarder Boolean
  feeType   FeeType
  amount    Float

  @@unique([academicYearId, schoolClassId, isBoarder, feeType])
}

model PaymentAllocation {
  id String @id @default(cuid())

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String

  feeDue   FeeDue @relation(fields: [feeDueId], references: [id])
  feeDueId String

  amount Float

  @@index([paymentId])
  @@index([feeDueId])
}