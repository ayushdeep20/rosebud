// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  STAFF
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  mustChangePassword Boolean @default(true)
  createdAt    DateTime @default(now())

  student Student?
  teacher Teacher?
  staff   Staff?
}

model AcademicYear {
  id        String   @id @default(cuid())
  label     String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
}

model SchoolClass {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @unique

  sections Section[]
}

model Section {
  id      String @id @default(cuid())
  name    String

  schoolClass   SchoolClass @relation(fields: [schoolClassId], references: [id])
  schoolClassId String

  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]

  @@unique([schoolClassId, name])
}

model Subject {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  teacherAssignments TeacherAssignment[]
}

model Student {
  id           String   @id @default(cuid())
  studentCode  String   @unique
  admissionNumber String @unique

  firstName    String
  lastName     String
  dateOfBirth  DateTime
  photoUrl     String?
  gender       String?

  fatherName   String?
  fatherPhone  String?
  motherName   String?
  motherPhone  String?
  guardianName String?
  guardianPhone String?

  bloodGroup   String?
  category     String?
  religion     String?
  address      String?
  district     String?

  hostelFacility Boolean @default(false)
  busFacility    Boolean @default(false)
  busNo          String?
  busPoint       String?

  height       Float?
  weight       Float?

  regNo                 String?
  fathersQualification  String?
  fathersOccupation     String?
  previousSchool        String?
  remarks               String?
  apaarId               String?
  penNo                 String?
  aadhaarEncrypted      String?

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  enrollments Enrollment[]

  createdAt DateTime @default(now())
}

model Enrollment {
  id String @id @default(cuid())

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  section   Section @relation(fields: [sectionId], references: [id])
  sectionId String

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId String

  rollNumber Int?

  @@unique([studentId, academicYearId])
}

model Teacher {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  phone     String?

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  assignments TeacherAssignment[]

  createdAt DateTime @default(now())
}

model TeacherAssignment {
  id String @id @default(cuid())

  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId String

  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId String

  section   Section @relation(fields: [sectionId], references: [id])
  sectionId String

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId String

  isClassTeacher Boolean @default(false)

  @@unique([teacherId, subjectId, sectionId, academicYearId])
}

model Staff {
  id            String    @id @default(cuid())
  staffCode     String    @unique
  firstName     String
  lastName      String
  designation   String
  phone         String?
  email         String?
  dateOfJoining DateTime?
  isActive      Boolean   @default(true)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// Powers safe, concurrency-proof Student ID generation (e.g. RBS-2026-0001).
// A single row per year is atomically incremented, so two admins creating
// students at the same moment can never receive the same number.
model IdCounter {
  id    String @id @default(cuid())
  key   String @unique
  value Int    @default(0)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}